#!/usr/bin/env php
<?php

// Opcional no check:rapido: formata localmente e apenas confere no CI.
declare(strict_types=1);

use KitRigor\Config;
use KitRigor\Formatacao\Formatador;

require $_composer_autoload_path ?? __DIR__.'/../vendor/autoload.php';

$ci = strtolower(trim((string) getenv('CI')));
try {
    exit(new Formatador(Config::doProjeto()->raiz)->executar(!in_array($ci, ['', '0', 'false'], true)));
} catch (JsonException|RuntimeException $erro) {
    fwrite(STDERR, $erro->getMessage()."\n");
    exit(1);
}
